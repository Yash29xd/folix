{
 "name": "Folix PDF Viewer",
 "short_name": "Folix",
 "description": "Private, fast PDF viewer that runs in your browser.",
 "id": "./",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#f4efe3",
 "theme_color": "#ff6a00",
 "icons": [
  {
   "src": "assets/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "assets/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "assets/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "application/pdf": [
     ".pdf"
    ]
   },
   "icons": [
    {
     "src": "assets/filetype-256.png",
     "sizes": "256x256",
     "type": "image/png"
    },
    {
     "src": "assets/filetype-128.png",
     "sizes": "128x128",
     "type": "image/png"
    },
    {
     "src": "assets/filetype-64.png",
     "sizes": "64x64",
     "type": "image/png"
    },
    {
     "src": "assets/filetype-48.png",
     "sizes": "48x48",
     "type": "image/png"
    },
    {
     "src": "assets/filetype-32.png",
     "sizes": "32x32",
     "type": "image/png"
    }
   ],
   "launch_type": "single-client",
   "name": "PDF document"
  }
 ],
 "launch_handler": {
  "client_mode": "navigate-existing"
 },
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "pdf",
     "accept": [
      "application/pdf",
      ".pdf"
     ]
    }
   ]
  }
 }
}